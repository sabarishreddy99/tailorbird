      "locked": false,
      "fontSize": 15.344401041666668,
      "fontFamily": 1,
      "text": "job_queue.json is the single contract between UI, agent, and skill - three writers, one file, one lock. LIBRARY.md is the durable knowledge; the queue is the lifecycle.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "job_queue.json is the single contract between UI, agent, and skill - three writers, one file, one lock. LIBRARY.md is the durable knowledge; the queue is the lifecycle.",

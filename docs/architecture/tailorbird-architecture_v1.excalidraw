    },
    {
      "id": "pab",
      "type": "text",
      "x": 55.34375,
      "y": 2082.3489583333335,
      "width": 309.7113952636719,
      "height": 210.98551432291669,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1981084165,
      "version": 204,
      "versionNonce": 170620323,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785516846031,
      "link": null,
      "locked": false,
      "fontSize": 15.344401041666668,
      "fontFamily": 1,
      "text": "· Skill loaded once, reused per job\n· Forked prefix = cache read (~0.1x)\n· 77k -> 42k fresh tokens per resume\n· $1.23 -> $0.92 per resume, measured\n· Kit slicing: 35k library -> 9k kit\n· 6 unused MCP servers never load\n· Research gated on company/archetype\n· Verify by text+grep, not screenshots\n· Telemetry splits fresh vs cache tokens\n· Serial beats parallel here: one warm\n  session outperformed N cold ones",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "· Skill loaded once, reused per job\n· Forked prefix = cache read (~0.1x)\n· 77k -> 42k fresh tokens per resume\n· $1.23 -> $0.92 per resume, measured\n· Kit slicing: 35k library -> 9k kit\n· 6 unused MCP servers never load\n· Research gated on company/archetype\n· Verify by text+grep, not screenshots\n· Telemetry splits fresh vs cache tokens\n· Serial beats parallel here: one warm\n  session outperformed N cold ones",
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "b0p"
    },

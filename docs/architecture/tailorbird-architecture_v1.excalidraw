    },
    {
      "id": "pbb",
      "type": "text",
      "x": 504.56380208333337,
      "y": 2082.3489583333335,
      "width": 354.45566406250003,
      "height": 211.04453125000003,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 401734327,
      "version": 200,
      "versionNonce": 832435437,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785516404267,
      "link": null,
      "locked": false,
      "fontSize": 15.344401041666668,
      "fontFamily": 1,
      "text": "· flock on agent/.lock - one run at a time\n· Children write no shared state at all\n· Parent commits, naturally serialized\n· Atomic temp-file + rename on every save\n· Row-scoped PATCH; whole-file PUT gone\n· Auto-refresh never clobbers a live edit\n· Status regression guard on every write\n· PDF served with path-traversal guard\n· 900s watchdog + one re-prime retry\n· Failed builds stay 'queued' and retry\n  on the next run - no lost work",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "· flock on agent/.lock - one run at a time\n· Children write no shared state at all\n· Parent commits, naturally serialized\n· Atomic temp-file + rename on every save\n· Row-scoped PATCH; whole-file PUT gone\n· Auto-refresh never clobbers a live edit\n· Status regression guard on every write\n· PDF served with path-traversal guard\n· 900s watchdog + one re-prime retry\n· Failed builds stay 'queued' and retry\n  on the next run - no lost work",
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "b0s"
    },

      "versionNonce": 698958893,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785516404266,
      "link": null,
      "locked": false,
      "fontSize": 15.344401041666668,
      "fontFamily": 1,
      "text": "Stages 1-3 run in a thread pool (<= 8). All HTTP is urllib inside Python, never a model tool - so a new ATS host never raises a permission prompt.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Stages 1-3 run in a thread pool (<= 8). All HTTP is urllib inside Python, never a model tool - so a new ATS host never raises a permission prompt.",
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "ao"
    },
    {
      "id": "z2n2",
      "type": "text",
      "x": 63.75346374511719,
      "y": 883.7612762451172,
      "width": 1144.7998622258506,
      "height": 19.180501302083336,
      "angle": 0,
      "strokeColor": "#b91c1c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,

    },
    {
      "id": "z6b",
      "type": "text",
      "x": 56.03515625,
      "y": 2521.4348958333335,
      "width": 1240.6538411458332,
      "height": 153.44401041666669,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 434529135,
      "version": 200,
      "versionNonce": 238985005,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785516404267,
      "link": null,
      "locked": false,
      "fontSize": 15.344401041666668,
      "fontFamily": 1,
      "text": "· JSON files over a database - the queue stays git-diffable, greppable, and readable inside a Claude session; ops cost is zero.\n· Regex screening over an LLM screen - eligibility rules are cheap, deterministic, and every drop is explainable by the sentence that triggered it.\n· The tailoring logic lives in a vendored third-party skill, not in this repo's Python - quality can be edited as prose without touching code.\n· Orchestrator owns mechanics, model owns judgment - the boundary is drawn where determinism stops being possible, not where it is convenient.\n· stdlib-only Python and a single-file UI - clone and run; nothing to install but Chrome and one npm package.\n\nNext: cron/systemd + Task Scheduler parity · a recorded-fixture test harness for ATS adapters · an eval set that scores coverage claims against\nreal callbacks · multi-candidate libraries so the system serves more than one person.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "· JSON files over a database - the queue stays git-diffable, greppable, and readable inside a Claude session; ops cost is zero.\n· Regex screening over an LLM screen - eligibility rules are cheap, deterministic, and every drop is explainable by the sentence that triggered it.\n· The tailoring logic lives in a vendored third-party skill, not in this repo's Python - quality can be edited as prose without touching code.\n· Orchestrator owns mechanics, model owns judgment - the boundary is drawn where determinism stops being possible, not where it is convenient.\n· stdlib-only Python and a single-file UI - clone and run; nothing to install but Chrome and one npm package.\n\nNext: cron/systemd + Task Scheduler parity · a recorded-fixture test harness for ATS adapters · an eval set that scores coverage claims against\nreal callbacks · multi-candidate libraries so the system serves more than one person.",
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "b0y"
    },

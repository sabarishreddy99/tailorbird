      "fontSize": 18.885416666666668,
      "fontFamily": 1,
      "text": "P1 · Cost & latency",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "P1 · Cost & latency",
      "lineHeight": 1.25,
      "autoResize": true,

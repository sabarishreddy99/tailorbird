      "seed": 1257643120,
      "version": 204,
      "versionNonce": 363476621,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785516404266,
      "link": null,
      "locked": false,
      "fontSize": 15.344401041666668,
      "fontFamily": 1,
      "text": "HARD_DROP  visa sponsorship refused · security clearance · ITAR / U.S.-person · citizenship required · posting removed  ->  dropped, 0 tokens spent",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "HARD_DROP  visa sponsorship refused · security clearance · ITAR / U.S.-person · citizenship required · posting removed  ->  dropped, 0 tokens spent",
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "ap"
    },
    {
      "id": "z2n3",
      "type": "text",
      "x": 64.29752604166667,
      "y": 912.6334635416667,
      "width": 1173.1384765625,
      "height": 19.121484375,
      "angle": 0,
      "strokeColor": "#b45309",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 737023408,
      "version": 200,
      "versionNonce": 228449517,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785516404266,
      "link": null,
      "locked": false,
      "fontSize": 15.344401041666668,
      "fontFamily": 1,
      "text": "NEEDS_REVIEW  entry-level title with no comp · comp ceiling < $100K · required language the candidate lacks · PERM filing markers (#LI-DNI)",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "NEEDS_REVIEW  entry-level title with no comp · comp ceiling < $100K · required language the candidate lacks · PERM filing markers (#LI-DNI)",
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "aq"
    },
    {
      "id": "z2n4",
      "type": "text",
      "x": 64.29752604166667,
      "y": 940.9615885416667,
      "width": 1223.775,
      "height": 19.121484375,
      "angle": 0,
      "strokeColor": "#757575",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1691799176,
      "version": 200,
      "versionNonce": 1762506573,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785516404266,
      "link": null,
      "locked": false,
      "fontSize": 15.344401041666668,
      "fontFamily": 1,
      "text": "False-positive guards: EEO boilerplate near 'citizenship' is ignored; an unresolved Greenhouse board token returns 'unresolved', never 'removed'.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "False-positive guards: EEO boilerplate near 'citizenship' is ignored; an unresolved Greenhouse board token returns 'unresolved', never 'removed'.",
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "ar"
    },
    {
      "id": "z2n5",
      "type": "text",
      "x": 64.29752604166667,
      "y": 969.2897135416667,
      "width": 970.5923828125,
      "height": 19.121484375,
      "angle": 0,
      "strokeColor": "#757575",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 435087737,
      "version": 200,
      "versionNonce": 1381189037,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785516404266,
      "link": null,
      "locked": false,
      "fontSize": 15.344401041666668,
      "fontFamily": 1,
      "text": "Comp parser handles $182,800-$247,300 · $116,000 - $174,000 USD · $215-230K · flat ranges, and ignores '5-8 years'.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Comp parser handles $182,800-$247,300 · $116,000 - $174,000 USD · $215-230K · flat ranges, and ignores '5-8 years'.",

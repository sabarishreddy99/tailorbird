    {
      "id": "z2n1",
      "type": "text",
      "x": 64.29752604166667,
      "y": 855.9772135416667,
      "width": 1123.716943939527,
      "height": 19.180501302083336,
      "angle": 0,
      "strokeColor": "#757575",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,

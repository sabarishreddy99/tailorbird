    {
      "id": "pcb",
      "type": "text",
      "x": 953.0924479166667,
      "y": 2082.3489583333335,
      "width": 362.9541015625,
      "height": 211.04453125000003,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1887167598,
      "version": 200,
      "versionNonce": 2121211917,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785516404267,
      "link": null,
      "locked": false,
      "fontSize": 15.344401041666668,
      "fontFamily": 1,
      "text": "· Truthfulness Boundaries are hard limits\n· Reframes real experience, invents none\n· Projected coverage < ~65% -> needs_review\n· Ambiguity is parked, never guessed\n· The agent never marks a role 'applied'\n· Every drop carries the exact reason\n· Coverage + gap report beside each resume\n· One-click Build / Drop on parked rows\n· needs_review is a feature, not a failure:\n  it is where the system admits it should\n  not decide for you",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "· Truthfulness Boundaries are hard limits\n· Reframes real experience, invents none\n· Projected coverage < ~65% -> needs_review\n· Ambiguity is parked, never guessed\n· The agent never marks a role 'applied'\n· Every drop carries the exact reason\n· Coverage + gap report beside each resume\n· One-click Build / Drop on parked rows\n· needs_review is a feature, not a failure:\n  it is where the system admits it should\n  not decide for you",
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "b0v"
    },
